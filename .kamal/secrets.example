# Template only. Copy to .kamal/secrets (gitignored) before the first deploy.
# NEVER commit .kamal/secrets, and never paste a real token into this file.
#
#   cp .kamal/secrets.example .kamal/secrets
#
# Both values are read from the deploying shell's environment, so the token
# itself never lands on disk in this repo:
#
#   export KAMAL_REGISTRY_USERNAME=<github-username>
#   export KAMAL_REGISTRY_PASSWORD=<github PAT with write:packages>
#
# The same GHCR credentials already used for onside-rails and captain-rails.

KAMAL_REGISTRY_USERNAME=$KAMAL_REGISTRY_USERNAME
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
